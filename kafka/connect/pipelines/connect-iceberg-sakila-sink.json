{
  "name": "sakila-lakehouse-icebgerg-sink",
  "config": {
    "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
    "tasks.max": "2",
    "topics": "sakila.public.actor,sakila.public.film,sakila.public.category",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter.schemas.enable": "false",
    "consumer.override.auto.offset.reset": "earliest",
    "iceberg.kafka.auto.offset.reset": "earliest",
    "iceberg.tables": "sakila.actor, sakila.film",
    "iceberg.tables.default-id-columns": "actor_id,film_id",
    "iceberg.tables.default-timestamp-columns": "last_update",
    "iceberg.tables.auto-create-enabled": "true",
    "iceberg.tables.evolve-schema-enabled": "true",
    "iceberg.control.commit.interval-ms": "1000",
    "iceberg.control.commit.timeout-ms": "20000",
    "iceberg.catalog.type": "rest",
    "iceberg.catalog.uri": "http://nessie:19120/api/",
    "iceberg.catalog.ref": "main",
    "iceberg.catalog.warehouse": "s3://lakehouse",
    "iceberg.catalog.client.region": "us-west-2",
    "iceberg.catalog.client.s3.endpoint": "http://0.0.0.0:9000",
    "iceberg.catalog.client.s3.path-style-access": "true",
    "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
    "iceberg.catalog.s3.access-key-id": "h4g8ZtguYBTULhYsJ8um",
    "iceberg.catalog.s3.secret-access-key": "E2lOhNzXgh0ACqneBHq61b5VJE0kGwV3APP8Xxup",
    "iceberg.catalog.s3.path-style-access": "true",
    "iceberg.kafka.bootstrap.servers": "broker:9092"
  }
}
